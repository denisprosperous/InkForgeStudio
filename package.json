{
  "name": "inkforge-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inkforge Studio — Forge books. Not prompts. The complete studio for authors publishing KDP-compliant ebooks.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/forge",
    "packages/config",
    "packages/db",
    "packages/ai",
    "packages/core",
    "packages/covers",
    "packages/ui"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build-all.js",
    "build:libs": "tsc -b",
    "build:web": "npm run build -w @inkforge/web",
    "start": "node scripts/start.js",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc --noEmit -p apps/web",
    "pretest": "npm run build:libs",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:stubs": "tsx scripts/audit-stubs.ts",
    "audit:dod": "tsx scripts/audit-dod.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:seed": "tsx packages/db/seed.ts",
    "db:studio": "drizzle-kit studio --config packages/db/drizzle.config.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build",
    "bench:forge": "tsx scripts/bench-forge.ts",
    "deploy:web": "npx wrangler pages deploy .vercel/output/static --project-name=inkforge-studio",
    "preview:web": "npx @cloudflare/next-on-pages --experimental-minify && npx wrangler pages dev .vercel/output/static",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "1.49.1",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitest/coverage-v8": "2.1.8",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.17.0",
    "husky": "9.1.7",
    "lint-staged": "15.3.0",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
