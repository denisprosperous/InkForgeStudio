# ── Auth (Stack Auth) ──────────────────────────────────────────────
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# ── AI Providers (server-only, never sent to client) ───────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/inkforge

# ── Worker / Web bridge ────────────────────────────────────────────
FORGE_BASE_URL=http://localhost:4000
FORGE_SHARED_SECRET=

# ── Encryption for stored user keys ────────────────────────────────
KEY_ENCRYPTION_SECRET=

# ── Feature flags ──────────────────────────────────────────────────
ALLOW_FILE_UPLOADS=true
ALLOW_COVER_GENERATION=true
ALLOW_LAVISH_FORMATTING=true
LOCAL_LLM_ENABLED=false
PUBLIC_FALLBACK_ENABLED=false

# ── Runtime ────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_JOBS_PER_USER=5
MAX_UPLOAD_MB=20
EXPORT_URL_TTL_SECONDS=900

# ── Cloudflare Pages (build-time only) ─────────────────────────────
NODE_VERSION=24
NEXT_TELEMETRY_DISABLED=1
